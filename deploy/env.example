# /etc/fileshare/env —— 部署时复制为 /etc/fileshare/env
# 建议权限 root:root 640
#
# 注意：这个文件用 EnvironmentFile 注入，格式是 KEY=VALUE，
# 不要加 export，不要给值加引号。

# ---- 监听 ----
# 只绑本机回环，配合 SSH 隧道访问，不开公网
HTTP_HOST=127.0.0.1
HTTP_PORT=18080

# ---- 目录 ----
# 用户上传/下载的文件落在这里
SHARE_DIR=/var/lib/fileshare/shared
# 运行时数据（剪贴板内容、上传中转临时文件）
DATA_DIR=/var/lib/fileshare/data

# ---- 限制 ----
# 单文件上传上限（MB），0 = 不限制
MAX_UPLOAD_MB=4096
# 共享剪切板单张图片上限（MB）
CLIPBOARD_MAX_IMAGE_MB=20
# 共享剪切板最多保留条数
CLIPBOARD_MAX_ENTRIES=200

# ---- 时区 ----
# 服务器默认 UTC，不设这个剪贴板时间戳会差 8 小时
TZ=Asia/Shanghai
